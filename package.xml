<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openxr_ros2_bridge</name>
  <version>0.0.0</version>
  <description>OpenXR controller/tracker poses to ROS 2 TwistStamped commands for VR teleoperation (ARISE Tele-Craft Module A)</description>
  <maintainer email="toma.dimcic@gmail.com">Tomislav Dimcic</maintainer>
  <license>Apache-2.0</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_mypy</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_xmllint</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
